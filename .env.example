# Runtime
ECHO_ENV=development
ECHO_PORT=8080
ECHO_PUBLIC_BASE_URL=http://localhost:8080
ECHO_COOKIE_SECURE=false

# Generate long random values; never commit real values.
ECHO_ADMIN_TOKEN=replace-with-at-least-20-random-characters
ECHO_SESSION_SECRET=replace-with-at-least-32-random-characters
# Encrypts application-managed credentials stored in MariaDB. Back this up: changing
# it makes existing encrypted settings unreadable.
ECHO_ENCRYPTION_KEY=replace-with-a-separate-32-character-random-secret

# Existing MariaDB server. TLS certificate verification is enabled by default.
# Supported TLS modes: true, false, preferred, skip-verify.
ECHO_MARIADB_HOST=db.example.internal
ECHO_MARIADB_PORT=3306
ECHO_MARIADB_TLS=true

# Echo business data. Use a database-scoped account, never an admin account.
ECHO_CORE_DB_NAME=echo_core
ECHO_CORE_DB_USER=echo_core
ECHO_CORE_DB_PASSWORD=replace-core-password

# HyperMeow/mdbstore session data. This must use a separate database and user.
ECHO_WHATSAPP_DB_NAME=echo_whatsapp
ECHO_WHATSAPP_DB_USER=echo_whatsapp
ECHO_WHATSAPP_DB_PASSWORD=replace-whatsapp-password

# WhatsApp owner and gateway
ECHO_WHATSAPP_ENABLED=true
# Optional fallback for unattended deployments. Normally, message Echo directly
# and select the discovered contact as owner in the authenticated WhatsApp UI.
ECHO_OWNER_JID=

# Optional environment fallback. Normally configure OpenAI in the authenticated
# System screen; Echo validates and encrypts the key in MariaDB.
ECHO_AI_ENABLED=false
ECHO_AI_BASE_URL=https://api.openai.com/v1
ECHO_AI_API_KEY=
ECHO_AI_MODEL=gpt-5-mini

# Private owner conversation context is retained locally, never via OpenAI
# Responses storage. Retention accepts Go duration syntax.
ECHO_ASSISTANT_HISTORY_LIMIT=12
ECHO_ASSISTANT_RETENTION=720h

# The GitHub token is entered in the authenticated application settings and is
# encrypted at rest with ECHO_ENCRYPTION_KEY.
ECHO_GITHUB_WEBHOOK_SECRET=

# Shared HMAC secret for local observers posting to /webhooks/monitor.
# Generate at least 32 random characters. An empty value disables the endpoint.
ECHO_MONITOR_WEBHOOK_SECRET=

# Worker limits
ECHO_WORKER_ENABLED=true
ECHO_MAX_REPO_MIB=256
ECHO_MAX_FILE_KIB=256
ECHO_APPROVAL_TTL=30m
