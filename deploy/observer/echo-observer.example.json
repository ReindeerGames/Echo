{
  "echoUrl": "https://echo.example.com",
  "source": "primary-observer",
  "interval": "30s",
  "timeout": "5s",
  "probes": [
    {
      "name": "application-ready",
      "serviceId": "svc_000000000000000000000001",
      "url": "https://application.example.com/readyz",
      "method": "GET",
      "expectedStatusMin": 200,
      "expectedStatusMax": 299,
      "tlsWarningDays": 30,
      "tlsCriticalDays": 7
    }
  ],
  "tcpProbes": [
    {
      "name": "primary-database",
      "serviceId": "svc_000000000000000000000002",
      "host": "database.internal.example",
      "port": 3306
    }
  ],
  "systemProbes": [
    {
      "name": "primary-host",
      "serviceId": "svc_000000000000000000000003",
      "diskPath": "/",
      "diskWarningPercent": 85,
      "diskCriticalPercent": 95,
      "memoryWarningPercent": 85,
      "memoryCriticalPercent": 95,
      "loadWarningPerCpu": 1,
      "loadCriticalPerCpu": 2
    }
  ],
  "processProbes": [
    {
      "name": "application-worker-process",
      "serviceId": "svc_000000000000000000000006",
      "proxyUrl": "http://127.0.0.1:23751",
      "processName": "app-worker",
      "minimumCount": 1,
      "maximumCount": 4,
      "rssWarningMiB": 1024,
      "rssCriticalMiB": 1536
    }
  ],
  "dockerProbes": [
    {
      "name": "application-container",
      "serviceId": "svc_000000000000000000000004",
      "proxyUrl": "http://127.0.0.1:23750",
      "container": "application"
    }
  ],
  "freshnessProbes": [
    {
      "name": "database-backup",
      "serviceId": "svc_000000000000000000000005",
      "path": "/var/backups/application",
      "matchSuffix": ".sql.gz",
      "warningAge": "26h",
      "criticalAge": "50h"
    }
  ]
}
