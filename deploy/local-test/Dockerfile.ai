FROM golang:1.26.10-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/echo-test-ai ./cmd/echo-test-ai
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/echo-test-ai ./cmd/echo-test-ai

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 --no-create-home echo-test
COPY --from=build /out/echo-test-ai /usr/local/bin/echo-test-ai
USER echo-test
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/echo-test-ai"]
