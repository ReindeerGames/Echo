{
  "echoUrl": "http://127.0.0.1:8080",
  "source": "local-observer",
  "interval": "30s",
  "timeout": "3s",
  "allowInsecureHttp": true,
  "probes": [
    {
      "name": "echo-ready",
      "serviceId": "svc_local_echo",
      "url": "http://127.0.0.1:8080/readyz",
      "method": "GET",
      "expectedStatusMin": 200,
      "expectedStatusMax": 299
    }
  ],
  "tcpProbes": [
    {
      "name": "echo-listener",
      "serviceId": "svc_local_tcp",
      "host": "127.0.0.1",
      "port": 8080
    }
  ],
  "systemProbes": [
    {
      "name": "local-host",
      "serviceId": "svc_local_host",
      "diskPath": "/",
      "diskWarningPercent": 99,
      "diskCriticalPercent": 100,
      "memoryWarningPercent": 99,
      "memoryCriticalPercent": 100,
      "loadWarningPerCpu": 19,
      "loadCriticalPerCpu": 20
    }
  ],
  "processProbes": [
    {
      "name": "local-sleep-process",
      "serviceId": "svc_local_process",
      "proxyUrl": "http://127.0.0.1:23751",
      "processName": "sleep",
      "minimumCount": 1,
      "maximumCount": 100
    }
  ],
  "dockerProbes": [
    {
      "name": "local-mock-ai-container",
      "serviceId": "svc_local_container",
      "proxyUrl": "http://127.0.0.1:23750",
      "container": "echo-local-test-mock-ai-1"
    }
  ]
}
