# Disposable local test environment only. Do not reuse these database passwords.
ECHO_LOCAL_PORT=8080
ECHO_ENV=development
ECHO_PUBLIC_BASE_URL=http://localhost:8080
ECHO_COOKIE_SECURE=false
ECHO_DEV_MODE=false
ECHO_ADMIN_TOKEN=echo-local-admin-token
ECHO_SESSION_SECRET=echo-local-session-secret-change-me-2026
ECHO_ENCRYPTION_KEY=echo-local-encryption-key-change-me-2026

# The local Compose network provides this MariaDB server.
ECHO_MARIADB_HOST=mariadb
ECHO_MARIADB_PORT=3306
ECHO_MARIADB_TLS=false
ECHO_CORE_DB_NAME=echo_local_core
ECHO_CORE_DB_USER=echo_local_core
ECHO_CORE_DB_PASSWORD=echo-local-core-password
ECHO_WHATSAPP_DB_NAME=echo_local_whatsapp
ECHO_WHATSAPP_DB_USER=echo_local_whatsapp
ECHO_WHATSAPP_DB_PASSWORD=echo-local-whatsapp-password

# Pair a dedicated test number in the UI. Message Echo directly, then select the
# discovered contact as owner in the WhatsApp screen. This remains an optional
# environment fallback for unattended deployments.
ECHO_OWNER_JID=
ECHO_WHATSAPP_ENABLED=true
ECHO_WHATSAPP_HISTORY_SYNC=false

# Deterministic local stub: proves the workflow without sending data externally.
ECHO_AI_ENABLED=true
ECHO_AI_BASE_URL=http://mock-ai:8090/v1
ECHO_AI_API_KEY=local-test-only
ECHO_AI_MODEL=echo-local-test
ECHO_ASSISTANT_HISTORY_LIMIT=12
ECHO_ASSISTANT_RETENTION=168h
ECHO_ATTACHMENT_RETENTION=168h
ECHO_WHATSAPP_OUTBOX_RETENTION=168h

ECHO_GITHUB_WEBHOOK_SECRET=
ECHO_GITHUB_MONITOR_INTERVAL=1m
ECHO_MONITOR_WEBHOOK_SECRET=local-monitor-webhook-secret-with-32-chars
ECHO_MONITOR_WATCHDOG_INTERVAL=5s
ECHO_MONITOR_ALERT_REMINDER_INTERVAL=15m
ECHO_MONITOR_RETENTION=168h
ECHO_WORKER_ENABLED=true
ECHO_WORKER_POLL_INTERVAL=1s
ECHO_WORKER_JOB_LEASE=2m
ECHO_WORKER_HEARTBEAT_INTERVAL=5s
ECHO_WORKER_HEARTBEAT_TIMEOUT=15s
ECHO_WORKER_QUEUE_STALL_TIMEOUT=30s
ECHO_MAX_REPO_MIB=64
ECHO_MAX_FILE_KIB=128
ECHO_APPROVAL_TTL=10m
